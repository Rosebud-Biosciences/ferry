{
  "$defs": {
    "Alert": {
      "properties": {
        "level": {
          "$ref": "#/$defs/Level"
        },
        "message": {
          "default": "",
          "type": "string"
        },
        "pipeline": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": "string"
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "level",
        "title"
      ],
      "type": "object"
    },
    "EventKind": {
      "description": "What an event is about. Later versions may add kinds: ignore any you do\nnot know.",
      "enum": [
        "register",
        "finalize",
        "failures",
        "log",
        "alert",
        "receipt"
      ],
      "type": "string"
    },
    "FileCopy": {
      "properties": {
        "destination": {
          "type": "string"
        },
        "etag": {
          "type": [
            "string",
            "null"
          ]
        },
        "uploaded_at": {
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "uri": {
          "type": "string"
        },
        "verified": {
          "description": "`size` or `sha256` for a verified copy; absent while it is still pending.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "destination",
        "uri"
      ],
      "type": "object"
    },
    "Level": {
      "enum": [
        "info",
        "warning",
        "error"
      ],
      "type": "string"
    },
    "Manifest": {
      "description": "A complete unit: every file, and where each destination holds it.",
      "properties": {
        "completed": {
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "created": {
          "format": "date-time",
          "type": "string"
        },
        "destinations": {
          "items": {
            "$ref": "#/$defs/ManifestDestination"
          },
          "type": "array"
        },
        "files": {
          "items": {
            "$ref": "#/$defs/ManifestFile"
          },
          "type": "array"
        },
        "finalize": {
          "description": "`keep`, `move` or `delete`: what happens to the source files.",
          "type": "string"
        },
        "first_seen": {
          "format": "date-time",
          "type": "string"
        },
        "generation": {
          "description": "Bumped each time the unit completes again after a change.",
          "format": "int64",
          "type": "integer"
        },
        "local_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "root": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "uri": {
          "description": "The unit on the first destination (the primary).",
          "type": "string"
        }
      },
      "required": [
        "unit",
        "generation",
        "uri",
        "root",
        "first_seen",
        "created",
        "finalize",
        "destinations",
        "files"
      ],
      "type": "object"
    },
    "ManifestDestination": {
      "properties": {
        "name": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "uri": {
          "type": "string"
        },
        "verify": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "uri",
        "required",
        "verify"
      ],
      "type": "object"
    },
    "ManifestFile": {
      "properties": {
        "backup_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "copies": {
          "items": {
            "$ref": "#/$defs/FileCopy"
          },
          "type": "array"
        },
        "local_path": {
          "type": "string"
        },
        "mtime": {
          "format": "date-time",
          "type": "string"
        },
        "path": {
          "description": "The path within the unit.",
          "type": "string"
        },
        "rel_path": {
          "description": "The path from the pipeline root.",
          "type": "string"
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "size": {
          "format": "int64",
          "type": "integer"
        },
        "uri": {
          "description": "The file on the first destination.",
          "type": "string"
        }
      },
      "required": [
        "path",
        "rel_path",
        "uri",
        "size",
        "mtime",
        "local_path",
        "copies"
      ],
      "type": "object"
    },
    "Original": {
      "description": "What became of the source files, or will once `finalize.after` passes.",
      "properties": {
        "action": {
          "description": "`keep`, `move` or `delete`.",
          "type": "string"
        },
        "at": {
          "description": "When it was done, or is due.",
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "done": {
          "type": "boolean"
        },
        "path": {
          "description": "Where `move` puts the unit.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "action",
        "done"
      ],
      "type": "object"
    },
    "Receipt": {
      "description": "A unit every destination holds, whose required registrars confirmed it:\none per unit and generation, for people rather than pipelines.",
      "properties": {
        "bytes": {
          "format": "int64",
          "type": "integer"
        },
        "delivered": {
          "format": "date-time",
          "type": "string"
        },
        "destinations": {
          "items": {
            "$ref": "#/$defs/ReceiptCopy"
          },
          "type": "array"
        },
        "duration_s": {
          "description": "From the unit's first file to delivery.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "files": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "first_seen": {
          "format": "date-time",
          "type": "string"
        },
        "generation": {
          "format": "int64",
          "type": "integer"
        },
        "original": {
          "$ref": "#/$defs/Original"
        },
        "registrars": {
          "description": "The registrars that confirmed the unit.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "unit": {
          "type": "string"
        },
        "update": {
          "description": "An earlier generation of the unit had a receipt already.",
          "type": "boolean"
        }
      },
      "required": [
        "unit",
        "generation",
        "update",
        "files",
        "bytes",
        "first_seen",
        "delivered",
        "duration_s",
        "destinations",
        "registrars",
        "original"
      ],
      "type": "object"
    },
    "ReceiptCopy": {
      "properties": {
        "name": {
          "type": "string"
        },
        "uri": {
          "type": "string"
        },
        "verified": {
          "description": "`sha256` if every file was read back and hashed; otherwise `size`.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "uri",
        "verified"
      ],
      "type": "object"
    },
    "ShippedLog": {
      "properties": {
        "day": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "node": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "size": {
          "format": "int64",
          "type": "integer"
        },
        "uri": {
          "type": "string"
        }
      },
      "required": [
        "node",
        "name",
        "day",
        "uri",
        "size",
        "sha256"
      ],
      "type": "object"
    },
    "TransferEvent": {
      "properties": {
        "at": {
          "format": "date-time",
          "type": "string"
        },
        "bytes": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "destination": {
          "type": [
            "string",
            "null"
          ]
        },
        "dst": {
          "type": "string"
        },
        "duration_ms": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "op": {
          "description": "`upload`, `adopt`, `move` or `delete`.",
          "type": "string"
        },
        "rel_path": {
          "type": "string"
        },
        "src": {
          "type": "string"
        },
        "status": {
          "description": "`ok`, `failed` or `changed`.",
          "type": "string"
        }
      },
      "required": [
        "rel_path",
        "op",
        "status",
        "src",
        "dst",
        "at"
      ],
      "type": "object"
    }
  },
  "$id": "https://raw.githubusercontent.com/Rosebud-Biosciences/ferry/main/schemas/event.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "One call to a hook. `id` is unique to the event, and a redelivery carries\nthe same one, so a consumer can drop repeats by it.",
  "properties": {
    "agent": {
      "description": "The ferry that sent it, as `ferry-ingest/VERSION`.",
      "type": "string"
    },
    "alert": {
      "anyOf": [
        {
          "$ref": "#/$defs/Alert"
        },
        {
          "type": "null"
        }
      ]
    },
    "event": {
      "$ref": "#/$defs/EventKind"
    },
    "id": {
      "type": "string"
    },
    "log": {
      "anyOf": [
        {
          "$ref": "#/$defs/ShippedLog"
        },
        {
          "type": "null"
        }
      ],
      "description": "`log`: the day's log file, shipped."
    },
    "manifest": {
      "anyOf": [
        {
          "$ref": "#/$defs/Manifest"
        },
        {
          "type": "null"
        }
      ],
      "description": "`register` and `finalize`: the unit."
    },
    "node": {
      "description": "The machine it ran on (`node` in the config).",
      "type": "string"
    },
    "pipeline": {
      "type": [
        "string",
        "null"
      ]
    },
    "receipt": {
      "anyOf": [
        {
          "$ref": "#/$defs/Receipt"
        },
        {
          "type": "null"
        }
      ]
    },
    "schema": {
      "const": "ferry.event/v1",
      "type": "string"
    },
    "transfers": {
      "description": "What the event reports: uploads with `register`, moves or deletes with\n`finalize`, failed transfers with `failures`.",
      "items": {
        "$ref": "#/$defs/TransferEvent"
      },
      "type": "array"
    }
  },
  "required": [
    "schema",
    "id",
    "event",
    "agent",
    "node"
  ],
  "title": "ferry event",
  "type": "object"
}
